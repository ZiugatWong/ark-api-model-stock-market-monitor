# Ark Game API 认证（必填）
# 在 game.arkengine.me 登录后，从浏览器开发者工具 Network 面板
# 找到对 /api/stock 的请求，复制其 Request Headers 中的 cookie 字段完整值（通常含 ptd_session）
ARK_GAME_COOKIE=

# 失败通知配置（可选）
# 留空则不发送通知，设置为 "telegram" 启用 Telegram 通知
ARK_GAME_API_FAILED_NOTIFICATION=
# 仅在启用 Telegram 通知时需要填写以下两项
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
